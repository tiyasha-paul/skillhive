{
    "manifest_version": 3,
    "name": "SkillHive V2 (Dark Mode)",
    "version": "1.0",
    "description": "Track your study habits and get AI insights.",
    "permissions": [
        "tabs",
        "storage",
        "activeTab",
        "alarms",
        "notifications"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "SkillHive Tracker"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content-script.js"
            ]
        }
    ],
    "icons": {
        "16": "skillhive-logo.png",
        "48": "skillhive-logo.png",
        "128": "skillhive-logo.png"
    }
}